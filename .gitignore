# Системный и сгенерированный мусор ОС/IDE
.directory
.DS_Store
Thumbs.db
*.zip
*.tar.gz

# Python кэш и виртуальные окружения
__pycache__/
*.py[cod]
*$py.class
.venv/
env/

# Служебные копии и блокировки базы памяти
memory/**/*.bak
memory/**/*.lock

# Промежуточные QA-отчеты и логи ревью (генерируются микроциклами)
qa/

# Промежуточные сегменты в source и output (отслеживаем только итоговые тексты)
source/**/segments/
output/**/SEG_*.md

# Опционально: если исходные сырые тексты не должны быть в публичном git (DRM/авторские права)
# source/